{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linksava",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hublink-db",
